def retirer_stock(stock, produit, quantite):
    if produit not in stock:
        raise KeyError(f'Le produit "{produit}" n\'existe pas dans le stock.')
    
    disponible = stock[produit]
    
    if quantite > disponible:
        raise StockInsuffisantError(produit, quantite, disponible)
    
    stock[produit] -= quantite
    success_msg = f"Retrait effectue : {quantite} {produit}."
    print(success_msg)

