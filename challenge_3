def traiter_journal_commandes(stock, commandes_brutes, chemin_journal="journal.txt"):
        with open(chemin_journal, "w", encoding="utf-8") as journal:
            for commande in commandes_brutes:
                try:
                    produit, quantite_str = commande.split(",")
                    
                    if produit not in stock:
                        raise KeyError("produit inconnu")
                        
                    try:
                        quantite = int(quantite_str)
                    except ValueError:
                        raise ValueError(f'quantite invalide ("{quantite_str}")')
                        
                    disponible = stock[produit]
                    if quantite > disponible:
                        raise StockInsuffisantError(produit, quantite, disponible)
                        
                    stock[produit] -= quantite
                    entree = f"[OK] {produit} :-{quantite} (reste {stock[produit]})\n"
                    
                except KeyError:
                    entree = f"[ERREUR] {produit} : produit inconnu\n"
                except ValueError as err:
                    entree = f"[ERREUR] {produit} : {err}\n"
                except StockInsuffisantError as err:
                    entree = f"[ERREUR] {produit} : {err}\n"
                    
                journal.write(entree)
    


