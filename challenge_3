import csv

def calculer_moyenne_csv(chemin):
    notes = []
    try:
        with open(chemin, "r", encoding="utf-8") as fichier:
            lecteur = csv.reader(fichier)
            next(lecteur, None) 
            
            for ligne in lecteur:
                if not ligne:
                    continue
                nom, note_str = ligne[0], ligne[1]
                try:
                    note = float(note_str)
                    notes.append(note)
                except ValueError:
                    print(f'Attention : note invalide pour "{nom}" ("{note_str}"), ligne ignoree.')
                    
        if notes:
            moyenne = round(sum(notes) / len(notes), 2)
            print(f"Moyenne calculee ({len(notes)} notes valides) : {moyenne}")
            return moyenne
        else:
            print("Aucune note valide trouvee.")
    except FileNotFoundError:
        print(f'Erreur : le fichier "{chemin}" n’existe pas.')

